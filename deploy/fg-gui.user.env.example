# ~/.config/fg-gui/env – Umgebung des Benutzerdienstes (systemd EnvironmentFile; dort wird %h NICHT ersetzt,
# daher absolute Pfade). Keine Geheimnisse hier ablegen.
FG_GUI_DATA_DIR=/home/BENUTZER/GUI-FourierGrating/data
FG_GUI_EXAMPLES_DIR=/home/BENUTZER/FourierGrating/examples
FG_GUI_WORKERS=1
FG_GUI_RETENTION_DAYS=90
#FG_GUI_MAX_RUNS=500
#FG_GUI_LOG_LEVEL=INFO
#FG_GUI_USER_HEADER=X-Remote-User
NVIDIA_TF32_OVERRIDE=0
