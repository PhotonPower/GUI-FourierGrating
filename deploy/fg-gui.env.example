# /etc/fg-gui/fg-gui.env – Umgebung des Dienstes (systemd EnvironmentFile). Keine Geheimnisse hier ablegen.

# --- GUI ---
FG_GUI_DATA_DIR=/var/lib/fg-gui
FG_GUI_EXAMPLES_DIR=/opt/fg-gui/FourierGrating/examples
FG_GUI_WORKERS=1                 # gleichzeitige Rechnungen (eine GPU; jede Rechnung nutzt alle Kerne)
FG_GUI_JOB_HISTORY=50

# --- FourierGrating (siehe dort docs/config_format.md, docs/python.md) ---
#FG_NUM_THREADS=32               # Threads je Rechnung (Standard: alle Kerne)
#FG_CORE=cpu                     # CPU-Kern erzwingen
#FG_PRECISION=fp64               # überschreibt "precision" der Konfiguration
#FG_GPU_STREAMS=4
NVIDIA_TF32_OVERRIDE=0
#CUDA_VISIBLE_DEVICES=0
